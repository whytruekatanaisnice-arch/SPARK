# --- App ---
ENV=development
DEBUG=True

# --- Database (Supabase Postgres, asyncpg driver) ---
# Get this from Supabase Project Settings -> Database -> Connection string (use "Session pooler" or direct URI)
# Format: postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Supabase Storage ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_service_role_key
SUPABASE_STORAGE_BUCKET=submissions

# --- Optional PAJSK FaceNet512 recognition service ---
# Set both values to enable face recognition in coach attendance.
# The token must match PAJSK_RECOGNITION_TOKEN in the PAJSK service process.
PAJSK_FACE_SERVICE_URL=
PAJSK_FACE_SERVICE_TOKEN=

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Outbound email (Gmail via App Password) ---
# 1) Turn on 2-Step Verification on the Google account that will send mail
# 2) Go to https://myaccount.google.com/apppasswords and create an app password (name it "SPARK")
# 3) Paste the 16-character password below WITHOUT spaces
# Leave SMTP_HOST blank to just print emails to the server console (local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
# Gmail rewrites the From address to the authenticated account, so keep these the same:
SMTP_FROM_EMAIL=yourschool.spark@gmail.com
SMTP_FROM_NAME=SPARK - Your School Name
# Link included in every email (your deployed frontend login page):
APP_LOGIN_URL=http://localhost:5500/login.html
